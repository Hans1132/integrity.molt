TELEGRAM_BOT_TOKEN=
AUTHORIZED_USER_ID=
LOG_LEVEL=INFO
X402_BASE_URL=http://127.0.0.1:3402
MOLTBOOK_API_BASE=https://www.moltbook.com/api/v1
MOLTBOOK_API_KEY_FILE=/root/.secrets/moltbook_api_key
LLM_CONFIG_FILE=/etc/moltbot/llm-config.env
ALLOWED_MODELS_FILE=/etc/moltbot/allowed-models.txt
SCANNER_REPORTS_DIR=/root/scanner/reports
HEARTBEAT_TRIGGER_FILE=/var/run/moltbot/trigger-heartbeat
HEARTBEAT_MARKER_FILE=/var/run/moltbot/last-heartbeat
HEARTBEAT_RUNNER_UNIT=moltbot-heartbeat-runner.service
OWN_MOLTBOOK_USER=integrity_molt
IDENTITY_PULL_TRIGGER_FILE=/var/run/moltbot/trigger-identity-pull
IDENTITY_ENV_FILE=/etc/moltbot/identity.env
IDENTITY_REPO_PATH=/root/x402-server
IDENTITY_RUNNER_UNIT=moltbot-identity-pull-runner.service
